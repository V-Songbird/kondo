{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "outDir": "out/types/electron",
    "skipLibCheck": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["electron", "shared", "test"],
  // test/ lives in this project but a renderer view's reading half is still
  // worth asserting, so the tests reach across into the app project through
  // a reference rather than by widening this project's include.
  "references": [{ "path": "./tsconfig.app.json" }]
}
